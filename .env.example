# Copy to .env.local. Never commit secrets. Demo is development-only and requires no Supabase.
DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
OPENAI_API_KEY=
# Choose a Responses-compatible model available in your OpenAI project.
OPENAI_MODEL=
# Hard maximum of requests/day (including failed requests). Set 0 to stop AI spending.
AI_DAILY_REQUEST_LIMIT=50
# Random secret, at least 32 characters, used to hash rate-limit identifiers.
RATE_LIMIT_SECRET=
# Set vercel on Vercel. Local development uses one shared local identifier.
TRUSTED_PROXY=local
# NODE_ENV is managed by Next.js; VERCEL is injected by Vercel automatically.
